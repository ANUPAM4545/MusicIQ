# ==========================================
# MusicIQ Environment Variables Example
# ==========================================

# ------------------------------------------
# Backend Configuration (Spring Boot)
# ------------------------------------------
# Spring Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL in Prod)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/musiciq
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# JWT Authentication Secret
# Must be a securely generated 256-bit string (32 bytes)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Server Port
SERVER_PORT=8080

# ------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------
# Base URL for the backend API
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ------------------------------------------
# Third-Party API Configuration
# ------------------------------------------
ITUNES_API_URL=https://itunes.apple.com
